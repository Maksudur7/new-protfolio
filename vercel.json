{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://protfolio-payload.vercel.app/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://protfolio-payload.vercel.app/admin/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://protfolio-payload.vercel.app/_next/:path*"
    }
  ]
}
